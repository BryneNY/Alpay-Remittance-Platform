<mxfile host="app.diagrams.net"><diagram name="Class diagram" id="cd"><mxGraphModel background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Alpay Remittance Platform: Class Diagram" style="text;html=1;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="40" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;How to read the lines&lt;/b&gt;&lt;br&gt;△ solid line, hollow triangle: inheritance (extends)&lt;br&gt;△ dashed line, hollow triangle: implements an interface&lt;br&gt;◆ filled diamond: composition (part of the whole)&lt;br&gt;◇ hollow diamond: aggregation (holds a list of)&lt;br&gt;→ solid arrow: association (has a reference to)&lt;br&gt;⇢ dashed arrow: dependency (uses or creates)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="4191" y="24" width="440" height="184" as="geometry" /></mxCell><mxCell id="n3" value="1. Ecosystem structure" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=10 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1893" height="1382" as="geometry" /></mxCell><mxCell id="n4" value="2. Users and roles" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=10 6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="2073" y="230" width="1978" height="702" as="geometry" /></mxCell><mxCell id="n5" value="3. Transfers and work requests" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;